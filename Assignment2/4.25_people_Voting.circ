    <tool name="AND Gate"/>
    <tool name="OR Gate"/>
    <tool name="XOR Gate"/>
    <tool name="NAND Gate"/>
    <tool name="NOR Gate"/>
    <sep/>
    <tool name="D Flip-Flop"/>
    <tool name="Register"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(320,520)" name="Splitter">
      <a name="facing" val="south"/>
      <a name="fanout" val="25"/>
      <a name="incoming" val="25"/>
    </comp>
    <comp lib="0" loc="(630,440)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="radix" val="10unsigned"/>
      <a name="type" val="output"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="6" loc="(320,540)" name="DipSwitch">
      <a name="number" val="25"/>
    </comp>
    <comp lib="6" loc="(720,420)" name="LED"/>
    <comp loc="(630,420)" name="vote25"/>
    <wire from="(320,420)" to="(320,520)"/>
    <wire from="(320,420)" to="(410,420)"/>
    <wire from="(630,420)" to="(720,420)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="vote25">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity vote25 is
    port(
        vt     : in  std_logic_vector(25 downto 1);
        result : out std_logic;
        cnt    : out std_logic_vector(4 downto 0)   -- 진단용: 센 개수
    );
end entity vote25;

architecture bhv of vote25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;
        for i in 1 to 25 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        cnt &lt;= conv_std_logic_vector(sum, 5);   -- 개수를 5비트로 출력

        if sum &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture bhv;</vhdl>
</project>
