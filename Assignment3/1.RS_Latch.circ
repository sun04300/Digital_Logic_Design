  <vhdl appearance="logisim_evolution" name="rs_latch">library ieee;
use ieee.std_logic_1164.all;

entity rs_latch is
    port (
        S  : in  std_logic;
        R  : in  std_logic;
        Qn : out std_logic;
        Q  : out std_logic
    );
end rs_latch;

architecture gate_level of rs_latch is
    signal q_int  : std_logic;
    signal qn_int : std_logic;
begin
    -- upper NOR gate : S, Q  -&gt; Qn
    qn_int &lt;= S nor q_int;

    -- lower NOR gate : R, Qn -&gt; Q
    q_int  &lt;= R nor qn_int;

    Qn &lt;= qn_int;
    Q  &lt;= q_int;
end gate_level;</vhdl>
