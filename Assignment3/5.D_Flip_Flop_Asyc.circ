    </comp>
    <comp loc="(620,200)" name="d_ff_async"/>
    <wire from="(370,200)" to="(400,200)"/>
    <wire from="(370,220)" to="(400,220)"/>
    <wire from="(370,240)" to="(400,240)"/>
    <wire from="(370,260)" to="(400,260)"/>
    <wire from="(620,200)" to="(650,200)"/>
    <wire from="(620,220)" to="(650,220)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="d_ff_async">library ieee;
use ieee.std_logic_1164.all;

entity d_ff_async is
    port (
        clk : in  std_logic;
        D   : in  std_logic;
        set : in  std_logic;
        clr : in  std_logic;
        Q   : out std_logic;
        Qn  : out std_logic
    );
end d_ff_async;

architecture behavioral of d_ff_async is
    signal q_int : std_logic := '0';
begin
    -- set and clr MUST be in the sensitivity list
    -- so the FF reacts immediately without waiting for clk
    process (clk, set, clr)
    begin
        if clr = '1' then              -- 1st priority : Clear
            q_int &lt;= '0';
        elsif set = '1' then           -- 2nd priority : Set
            q_int &lt;= '1';
        elsif rising_edge(clk) then    -- 3rd : normal D FF operation
            q_int &lt;= D;
        end if;
    end process;

    Q  &lt;= q_int;
    Qn &lt;= not q_int;
end behavioral;</vhdl>
